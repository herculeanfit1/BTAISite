# ==============================================================================
# BTAI-Site — 1Password Secret References
# ==============================================================================
# Resolved at runtime via: op run --env-file=.env.1p.template -- <command>
#
# OP_SERVICE_ACCOUNT_TOKEN must be set in your shell profile, not here.
# -----------------------------------------------------------------------------
# The op:// paths below are PLACEHOLDERS. This repo is public, so the real vault
# and item names are not committed — substitute them from the private runbook
# (or the 1Password entry for this project) before running `op run`.
#
# This site DOES have runtime secrets: the contact pipeline calls Resend and
# HubSpot and enqueues to an Azure Storage Queue. In production these are Key
# Vault references resolved by the Function App's managed identity, NOT values
# from this file — this template is for local development only.
# -----------------------------------------------------------------------------

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email delivery (Resend) ---
# Set EMAIL_TEST_MODE=true to short-circuit real delivery while developing.
EMAIL_TEST_MODE=true
RESEND_API_KEY=op://<vault>/<item>/credential
EMAIL_FROM=hello@bridgingtrust.ai
EMAIL_TO=sales@bridgingtrust.ai
EMAIL_ADMIN=admin@bridgingtrust.ai
EMAIL_REPLY_TO=hello@bridgingtrust.ai

# --- CRM (HubSpot) — optional locally; the upsert is non-blocking ---
HUBSPOT_TOKEN=op://<vault>/<item>/credential
HUBSPOT_PORTAL_ID=op://<vault>/<item>/portal-id

# --- Lead-classification queue — optional locally; the enqueue is non-blocking ---
# Queue-scoped, add-only SAS URL. Never a full account connection string.
CLASSIFY_QUEUE_SAS_URL=op://<vault>/<item>/sas-url
